{
  "name": "statistical-apps-portfolio",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/stat-core"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
